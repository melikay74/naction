# Dependencies and build output — regenerated by `npm install` / `npm run build`.
node_modules/
client/dist/
server/dist/
*.tsbuildinfo

# Deploy bundles — regenerated by scripts/build-deploy.sh.
deploy/
*.zip
*.tar.gz

# Runtime submissions — contains contact details of businesses applying.
data/applications.json
data/.applications.*.tmp

# Credentials. SMTP settings live in cPanel's environment variables, never in
# the repo. If you make a local .env for testing, it stays local.
.env
.env.*
!.env.example

# Full-size camera originals. Kept on disk as the source for
# client/scripts/optimize-images.sh, but far too large to commit or deploy —
# only the optimized copies in client/public/ ship.
assets-originals/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.swp
*.log
